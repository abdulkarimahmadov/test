@model DiscussionForum.Application.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="jumbotron bg-white rounded-3 p-5 mb-4 shadow-sm">
    <div class="container-fluid text-center">
        <h1 class="display-4 fw-bold">Welcome to Discussion Forum</h1>
        <p class="lead">Join the conversation! Share your thoughts, ask questions, and connect with the community.</p>
        @if (!User.Identity?.IsAuthenticated ?? true)
        {
            <div class="mt-4">
                <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus-fill"></i> Get Started
                </a>
                <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            </div>
        }
    </div>
</div>

<!-- Statistics -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-people-fill fs-1 text-primary"></i>
                <h3 class="mt-2">@Model.TotalUsers</h3>
                <p class="text-muted">Members</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-chat-left-text-fill fs-1 text-success"></i>
                <h3 class="mt-2">@Model.TotalTopics</h3>
                <p class="text-muted">Topics</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-card-list fs-1 text-warning"></i>
                <h3 class="mt-2">@Model.Categories.Count</h3>
                <p class="text-muted">Categories</p>
            </div>
        </div>
    </div>
</div>

<!-- Categories -->
<div class="row mb-4">
    <div class="col-12">
        <h2 class="mb-3"><i class="bi bi-grid-3x3-gap-fill"></i> Forum Categories</h2>
    </div>
    @foreach (var category in Model.Categories)
    {
        <div class="col-md-6 mb-3">
            <div class="card category-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div class="me-3" style="font-size: 2rem;">@category.Icon</div>
                        <div class="flex-grow-1">
                            <h5 class="card-title">
                                <a href="@Url.Action("Index", "Category", new { id = category.Id })" class="text-decoration-none">
                                    @category.Name
                                </a>
                            </h5>
                            <p class="card-text text-muted">@category.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary">@category.TopicCount Topics</span>
                                <a href="@Url.Action("Create", "Topic", new { categoryId = category.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-plus-circle"></i> New Topic
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Recent Topics -->
@if (Model.RecentTopics.Any())
{
    <div class="row">
        <div class="col-12">
            <h2 class="mb-3"><i class="bi bi-clock-history"></i> Recent Topics</h2>
        </div>
        @foreach (var topic in Model.RecentTopics.Take(5))
        {
            <div class="col-12 mb-3">
                <div class="card topic-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title">
                                    @if (topic.IsPinned)
                                    {
                                        <i class="bi bi-pin-angle-fill text-warning"></i>
                                    }
                                    <a href="@Url.Action("Details", "Topic", new { id = topic.Id })" class="text-decoration-none">
                                        @topic.Title
                                    </a>
                                </h5>
                                <p class="card-text text-muted small">
                                    <i class="bi bi-person"></i> @topic.UserDisplayName
                                    <span class="mx-2">•</span>
                                    <i class="bi bi-folder"></i> @topic.CategoryName
                                    <span class="mx-2">•</span>
                                    <i class="bi bi-clock"></i> @topic.CreatedDate.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info">@topic.PostCount Replies</span>
                                <span class="badge bg-secondary">@topic.ViewCount Views</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
