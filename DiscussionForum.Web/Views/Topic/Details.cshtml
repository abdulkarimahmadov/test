@model DiscussionForum.Application.ViewModels.TopicDetailsViewModel
@{
    ViewData["Title"] = Model.Topic.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Index" asp-route-id="@Model.Topic.CategoryId">@Model.Topic.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Topic.Title</li>
    </ol>
</nav>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0">
            @if (Model.Topic.IsPinned)
            {
                <i class="bi bi-pin-angle-fill"></i>
            }
            @if (Model.Topic.IsLocked)
            {
                <i class="bi bi-lock-fill"></i>
            }
            @Model.Topic.Title
        </h2>
        <small>
            <i class="bi bi-person"></i> @Model.Topic.UserDisplayName
            <span class="mx-2">•</span>
            <i class="bi bi-clock"></i> @Model.Topic.CreatedDate.ToString("MMM dd, yyyy HH:mm")
            <span class="mx-2">•</span>
            <i class="bi bi-eye-fill"></i> @Model.Topic.ViewCount views
        </small>
    </div>
    <div class="card-body">
        @Html.Raw(Model.Topic.Content)
    </div>
    <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                @if (User.Identity?.IsAuthenticated == true && User.Identity.Name == Model.Topic.UserDisplayName)
                {
                    <a asp-controller="Topic" asp-action="Edit" asp-route-id="@Model.Topic.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form asp-controller="Topic" asp-action="Delete" asp-route-id="@Model.Topic.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this topic?');">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>
                }
            </div>
            <div>
                @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                {
                    @if (Model.Topic.IsPinned)
                    {
                        <form asp-controller="Topic" asp-action="Unpin" asp-route-id="@Model.Topic.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-pin-angle"></i> Unpin</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Topic" asp-action="Pin" asp-route-id="@Model.Topic.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-pin-angle-fill"></i> Pin</button>
                        </form>
                    }
                    
                    @if (Model.Topic.IsLocked)
                    {
                        <form asp-controller="Topic" asp-action="Unlock" asp-route-id="@Model.Topic.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-unlock"></i> Unlock</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Topic" asp-action="Lock" asp-route-id="@Model.Topic.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-lock"></i> Lock</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>
</div>

<h3 class="mb-3"><i class="bi bi-chat-left-text"></i> Replies (@Model.Topic.PostCount)</h3>

@foreach (var post in Model.Posts)
{
    <div class="post-content mb-3" id="post-@post.Id">
        <div class="row">
            <div class="col-md-2 text-center">
                <div class="mb-2">
                    @if (!string.IsNullOrEmpty(post.UserAvatar))
                    {
                        <img src="@post.UserAvatar" alt="@post.UserDisplayName" class="user-avatar">
                    }
                    else
                    {
                        <i class="bi bi-person-circle" style="font-size: 2.5rem; color: var(--primary-color);"></i>
                    }
                </div>
                <div><strong>@post.UserDisplayName</strong></div>
                <small class="text-muted">Member</small>
            </div>
            <div class="col-md-10">
                <div class="d-flex justify-content-between mb-2">
                    <small class="text-muted">
                        <i class="bi bi-clock"></i> @post.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                        @if (post.IsEdited && post.EditedDate.HasValue)
                        {
                            <span class="ms-2">(Edited: @post.EditedDate.Value.ToString("MMM dd, yyyy HH:mm"))</span>
                        }
                    </small>
                    <div class="vote-buttons">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Post" asp-action="Upvote" asp-route-id="@post.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-arrow-up-circle"></i>
                                </button>
                            </form>
                            <span class="vote-count">@post.VoteCount</span>
                            <form asp-controller="Post" asp-action="Downvote" asp-route-id="@post.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-arrow-down-circle"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="vote-count">@post.VoteCount votes</span>
                        }
                    </div>
                </div>
                <div class="mb-2">
                    @Html.Raw(post.Content)
                </div>
                @if (User.Identity?.IsAuthenticated == true && (User.Identity.Name == post.UserDisplayName || User.IsInRole("Admin") || User.IsInRole("Moderator")))
                {
                    <div class="mt-2">
                        <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this post?');">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Details" asp-route-id="@Model.Topic.Id" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@if (User.Identity?.IsAuthenticated == true && !Model.Topic.IsLocked)
{
    <div class="card mt-4">
        <div class="card-header">
            <h4><i class="bi bi-chat-left-dots"></i> Post a Reply</h4>
        </div>
        <div class="card-body">
            <form asp-controller="Post" asp-action="Create" method="post">
                <input type="hidden" name="TopicId" value="@Model.Topic.Id" />
                <div class="mb-3">
                    <label for="Content" class="form-label">Your Reply</label>
                    <textarea name="Content" id="Content" class="form-control" rows="5" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i> Post Reply
                </button>
            </form>
        </div>
    </div>
}
else if (!User.Identity?.IsAuthenticated ?? true)
{
    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle"></i> Please <a asp-controller="Account" asp-action="Login">login</a> to reply to this topic.
    </div>
}
else if (Model.Topic.IsLocked)
{
    <div class="alert alert-warning mt-4">
        <i class="bi bi-lock-fill"></i> This topic is locked. No new replies can be posted.
    </div>
}
