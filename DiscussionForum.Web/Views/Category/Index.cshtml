@model DiscussionForum.Application.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = Model.Category.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Category.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1><span style="font-size: 2rem;">@Model.Category.Icon</span> @Model.Category.Name</h1>
        <p class="text-muted">@Model.Category.Description</p>
    </div>
    <div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Topic" asp-action="Create" asp-route-categoryId="@Model.Category.Id" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Topic
            </a>
        }
    </div>
</div>

@if (Model.Topics.Any())
{
    foreach (var topic in Model.Topics)
    {
        <div class="card topic-card mb-3 @(topic.IsPinned ? "pinned-topic" : "")">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <h5 class="card-title">
                            @if (topic.IsPinned)
                            {
                                <i class="bi bi-pin-angle-fill text-warning" title="Pinned"></i>
                            }
                            @if (topic.IsLocked)
                            {
                                <i class="bi bi-lock-fill text-danger" title="Locked"></i>
                            }
                            <a href="@Url.Action("Details", "Topic", new { id = topic.Id })" class="text-decoration-none">
                                @topic.Title
                            </a>
                        </h5>
                        <p class="card-text text-muted small mb-2">
                            <i class="bi bi-person"></i> Started by <strong>@topic.UserDisplayName</strong>
                            <span class="mx-2">•</span>
                            <i class="bi bi-clock"></i> @topic.CreatedDate.ToString("MMM dd, yyyy HH:mm")
                            @if (topic.LastActivityDate.HasValue)
                            {
                                <span class="mx-2">•</span>
                                <i class="bi bi-chat-left-text"></i> Last activity @topic.LastActivityDate.Value.ToString("MMM dd, yyyy HH:mm")
                            }
                        </p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-info">@topic.PostCount Replies</span>
                        <span class="badge bg-secondary">@topic.ViewCount Views</span>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-id="@Model.Category.Id" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No topics yet in this category. Be the first to create one!
    </div>
}
