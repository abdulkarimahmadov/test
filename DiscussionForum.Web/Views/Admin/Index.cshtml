@{
    ViewData["Title"] = "Admin Dashboard";
    var totalUsers = ViewBag.TotalUsers;
    var totalCategories = ViewBag.TotalCategories;
    var totalTopics = ViewBag.TotalTopics;
}

<h1><i class="bi bi-gear-fill"></i> Admin Dashboard</h1>
<p class="lead">Manage your forum from here</p>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow">
            <div class="card-body">
                <i class="bi bi-people-fill fs-1 text-primary"></i>
                <h3 class="mt-2">@totalUsers</h3>
                <p class="text-muted">Total Users</p>
                <a asp-action="Users" class="btn btn-primary btn-sm">Manage Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow">
            <div class="card-body">
                <i class="bi bi-grid-3x3-gap-fill fs-1 text-success"></i>
                <h3 class="mt-2">@totalCategories</h3>
                <p class="text-muted">Total Categories</p>
                <a asp-action="Categories" class="btn btn-success btn-sm">Manage Categories</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow">
            <div class="card-body">
                <i class="bi bi-chat-left-text-fill fs-1 text-warning"></i>
                <h3 class="mt-2">@totalTopics</h3>
                <p class="text-muted">Total Topics</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-warning btn-sm">View Forum</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Quick Actions</h4>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <a asp-action="CreateCategory" class="list-group-item list-group-item-action">
                        <i class="bi bi-plus-circle"></i> Create New Category
                    </a>
                    <a asp-action="Categories" class="list-group-item list-group-item-action">
                        <i class="bi bi-list"></i> Manage Categories
                    </a>
                    <a asp-action="Users" class="list-group-item list-group-item-action">
                        <i class="bi bi-people"></i> Manage Users
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
