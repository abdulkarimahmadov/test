@model IEnumerable<DiscussionForum.Application.DTOs.CategoryDto>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-grid-3x3-gap-fill"></i> Manage Categories</h1>
    <a asp-action="CreateCategory" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create Category
    </a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Icon</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Display Order</th>
                    <th>Topics</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td style="font-size: 1.5rem;">@category.Icon</td>
                        <td><strong>@category.Name</strong></td>
                        <td>@category.Description</td>
                        <td>@category.DisplayOrder</td>
                        <td><span class="badge bg-info">@category.TopicCount</span></td>
                        <td>
                            <a asp-action="EditCategory" asp-route-id="@category.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure? This will delete all topics in this category!');">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No categories found. Create one to get started!
    </div>
}

<a asp-action="Index" class="btn btn-secondary mt-3">
    <i class="bi bi-arrow-left"></i> Back to Dashboard
</a>
