@model DiscussionForum.Application.DTOs.CreateCategoryDto
@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h2><i class="bi bi-plus-circle"></i> Create New Category</h2>
            </div>
            <div class="card-body">
                <form asp-action="CreateCategory" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Technology" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the category"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Icon" class="form-label">Icon (Emoji)</label>
                        <input asp-for="Icon" class="form-control" placeholder="e.g., 💻" />
                        <span asp-validation-for="Icon" class="text-danger"></span>
                        <div class="form-text">Use an emoji as the category icon</div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        <div class="form-text">Lower numbers appear first</div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Categories" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Create Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
